# ─────────────────────────────────────────────────────────────────────────────
# Cultgig — environment variables
#
# Copy this file to `.env` (never commit `.env`).
#
# IMPORTANT: every variable starting with VITE_ is bundled into the JavaScript
# that every visitor downloads. Only put PUBLIC values here (IDs, URLs, flags).
# Secrets (Appwrite API keys, SMTP passwords, payment keys, webhook secrets)
# belong in Appwrite Function / server environment variables — never here.
# ─────────────────────────────────────────────────────────────────────────────

# App mode: "demo" or "production".
#   demo       → sample data + demo accounts stored in the visitor's browser. No backend needed.
#   production → requires the Appwrite settings below. Never falls back to demo data.
# If unset: `npm run dev` uses demo, production builds use production.
VITE_APP_MODE=demo

# Canonical site URL (used for links and metadata)
VITE_SITE_URL=https://www.cultgig.com

# ── Appwrite (public project identifiers) ────────────────────────────────────
VITE_APPWRITE_ENDPOINT=
VITE_APPWRITE_PROJECT_ID=
VITE_APPWRITE_DATABASE_ID=
VITE_APPWRITE_STORAGE_BUCKET_ID=
VITE_APPWRITE_USERS_COLLECTION_ID=
VITE_APPWRITE_ARTIST_PROFILES_COLLECTION_ID=
VITE_APPWRITE_CLIENT_PROFILES_COLLECTION_ID=
VITE_APPWRITE_GIGS_COLLECTION_ID=
VITE_APPWRITE_APPLICATIONS_COLLECTION_ID=
VITE_APPWRITE_CONVERSATIONS_COLLECTION_ID=
VITE_APPWRITE_MESSAGES_COLLECTION_ID=
VITE_APPWRITE_PROPOSALS_COLLECTION_ID=
VITE_APPWRITE_BOOKINGS_COLLECTION_ID=

# ── Sign-in providers ────────────────────────────────────────────────────────
# Set to true only after the Google provider is configured in the Appwrite console.
VITE_GOOGLE_OAUTH_ENABLED=false

# ── Payments ─────────────────────────────────────────────────────────────────
# Keep false until marketplace approval and all required server-side payment
# controls are deployed. See docs/INTEGRATIONS.md.
VITE_PAYMENTS_ENABLED=false
VITE_RAZORPAY_KEY_ID=

# Server-only (never prefix these with VITE_ or expose them to the browser).
PAYMENTS_ENABLED=false
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# ── Business & legal identity (shown on legal pages) ─────────────────────────
VITE_LEGAL_ENTITY_NAME=
VITE_ENTITY_TYPE=
VITE_REGISTERED_ADDRESS=
VITE_SUPPORT_EMAIL=
VITE_SUPPORT_PHONE=
VITE_GRIEVANCE_OFFICER_NAME=
VITE_GRIEVANCE_OFFICER_EMAIL=
VITE_CIN_LLPIN=
VITE_GSTIN=

# ── Social links (https only) ────────────────────────────────────────────────
VITE_INSTAGRAM_URL=
VITE_LINKEDIN_URL=
VITE_YOUTUBE_URL=

# ── Cloudinary ────────────────────────────────────────────────
VITE_CLOUDINARY_KEY_NAME=
VITE_CLOUDINARY_API_KEY=
VITE_CLOUDINARY_API_SECRET=
VITE_CLOUDINARY_CLOUD_NAME=